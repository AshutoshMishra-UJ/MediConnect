PORT=5000
NODE_ENV=development

# Comma-separated origins for web app(s)
CORS_ORIGIN=http://localhost:5173

# MongoDB
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<database>?retryWrites=true&w=majority
DB_NAME=MediConnect

# JWT/Auth
JWT_SECRET=replace_me
ACCESS_TOKEN_SECRET=replace_me
REFRESH_TOKEN_SECRET=replace_me
ACCESS_TOKEN_EXPIRY=7d
REFRESH_TOKEN_EXPIRY=30d
EMAIL_SECRET=replace_me

# Cloudinary
CLOUDINARY_NAME=replace_me
CLOUDINARY_KEY=replace_me
CLOUDINARY_SECRET=replace_me

# Twilio
TWILIO_ACCOUNT_SID=replace_me
TWILIO_AUTH_TOKEN=replace_me
TWILIO_PHONE_NUMBER=replace_me

# Razorpay
RAZORPAY_KEY_ID=replace_me
RAZORPAY_KEY_SECRET=replace_me

# Mail
EMAIL_USER=replace_me
EMAIL_PASS=replace_me

# AI
HUGGING_FACE_TOKEN=replace_me
